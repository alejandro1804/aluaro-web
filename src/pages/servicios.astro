---
import Base from '../layouts/Base.astro';
import LlamadaAccion from '../components/LlamadaAccion.astro';

const servicios = [
  {
    titulo: 'Mantenimiento preventivo',
    desc: 'Planes periódicos pensados para edificios, comercios y empresas. Revisamos el estado de la instalación y anticipamos problemas antes de que se conviertan en problemas mayores.',
    items: ['Revisiones programadas', 'Informe de estado', 'Limpieza de columnas', 'Coordinación con administración'],
  },
  {
    titulo: 'Asesoramiento',
    desc: 'Te orientamos sobre el estado de tu instalación y las mejores opciones antes de encarar una reforma o un recambio. Presupuesto y recomendaciones sin compromiso.',
    items: ['Diagnóstico de instalación', 'Opciones de reforma', 'Presupuesto detallado', 'Recomendaciones de uso'],
  },
];
---

<Base
  titulo="Servicios"
  descripcion="Servicios de Aluaro: mantenimiento preventivo y asesoramiento hidráulico y sanitario para edificios, comercios y hogares en Uruguay."
>
  <!-- Encabezado de página con imagen de fondo -->
  <section class="cabecera-pagina">
    <div class="cabecera-pagina__fondo" aria-hidden="true"></div>
    <div class="contenedor cabecera-pagina__contenido">
      <p class="cabecera-pagina__kicker">Servicios</p>
      <h1>Todo lo que hacemos con el agua de tu instalación</h1>
      <p class="cabecera-pagina__bajada">
        Desde el mantenimiento continuo de un edificio hasta el asesoramiento
        para una reforma. Estos son los servicios que ofrecemos.
      </p>
    </div>
  </section>

  <!-- Listado de servicios -->
  <section class="seccion">
    <div class="contenedor">
      <div class="lista-servicios">
        {
          servicios.map((s) => (
            <article class="servicio-det">
              <div class="servicio-det__cabecera">
                <h2>{s.titulo}</h2>
              </div>
              <p class="servicio-det__desc">{s.desc}</p>
              <ul class="servicio-det__items">
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bloque: equipos e instalaciones (bombas en exhibición) -->
  <section class="seccion seccion--claro">
    <div class="contenedor equipos">
      <div class="equipos__texto">
        <h2>Trabajamos con equipos de todo tipo</h2>
        <p>
          Bombas de presión, sistemas de recirculación, colectores y salas de
          máquinas. Conocemos los equipos que mantienen el agua funcionando en
          un edificio y sabemos cómo cuidarlos para alargar su vida útil.
        </p>
        <ul class="equipos__lista">
          <li>Bombas presurizadoras y de recirculación</li>
          <li>Colectores y válvulas</li>
          <li>Tableros y automatismos de bombeo</li>
          <li>Salas de máquinas de edificios</li>
        </ul>
      </div>
      <figure class="equipos__figura">
        <img
          src="/imagenes/bombas-exhibicion.jpg"
          alt="Bombas presurizadoras de distintos modelos instaladas en una sala de máquinas"
          loading="lazy"
          width="1000"
          height="1250"
        />
      </figure>
    </div>
  </section>

  <LlamadaAccion
    titulo="¿No ves lo que necesitás?"
    texto="Escribinos y te decimos si podemos ayudarte. La mayoría de los problemas hidráulicos entran dentro de lo que hacemos."
  />
</Base>

<style>
  /* Cabecera con imagen de fondo */
  .cabecera-pagina {
    position: relative;
    color: var(--blanco);
    padding: 5rem 0 4rem;
    overflow: hidden;
    isolation: isolate;
  }
  .cabecera-pagina__fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: url('/imagenes/sala-maquinas.jpg');
    background-size: cover;
    background-position: center;
  }
  .cabecera-pagina::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(150deg, rgba(10,37,64,0.92) 0%, rgba(18,85,126,0.82) 100%);
  }
  .cabecera-pagina__kicker {
    color: var(--agua);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }
  .cabecera-pagina h1 { color: var(--blanco); max-width: 20ch; }
  .cabecera-pagina__bajada {
    color: #dcecf5;
    font-size: 1.1rem;
    max-width: 56ch;
    margin-top: 1rem;
  }

  .lista-servicios {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }
  .servicio-det {
    border: 1px solid var(--linea);
    border-left: 4px solid var(--agua);
    border-radius: var(--radio);
    padding: 1.75rem;
    background: var(--blanco);
  }
  .servicio-det h2 {
    font-size: 1.35rem;
    color: var(--azul);
    margin-bottom: 0.75rem;
  }
  .servicio-det__desc {
    color: var(--gris);
    font-size: 0.98rem;
  }
  .servicio-det__items {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem 1rem;
  }
  .servicio-det__items li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.92rem;
    color: var(--texto);
  }
  .servicio-det__items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--agua);
  }

  /* Bloque equipos */
  .equipos {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }
  .equipos__texto h2 { color: var(--tinta); }
  .equipos__texto p { color: var(--gris); }
  .equipos__lista {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .equipos__lista li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--texto);
    font-size: 0.98rem;
  }
  .equipos__lista li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    background: var(--agua);
    border-radius: 2px;
    transform: rotate(45deg);
  }
  .equipos__figura {
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(10, 37, 64, 0.18);
  }
  .equipos__figura img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .lista-servicios { grid-template-columns: 1fr; }
    .equipos { grid-template-columns: 1fr; gap: 2rem; }
    .equipos__figura { max-height: 420px; }
  }
  @media (max-width: 460px) {
    .servicio-det__items { grid-template-columns: 1fr; }
  }
</style>