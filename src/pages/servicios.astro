---
import Base from '../layouts/Base.astro';
import LlamadaAccion from '../components/LlamadaAccion.astro';

const servicios = [
  {
    titulo: 'Mantenimiento preventivo',
    desc: 'Planes periódicos pensados para edificios, comercios y empresas. Revisamos el estado de la instalación y anticipamos problemas antes de que se conviertan en problemas mayores.',
    items: ['Revisiones programadas', 'Informe de estado', 'Limpieza de columnas', 'Coordinación con administración'],
  },
  {
    titulo: 'Asesoramiento',
    desc: 'Te orientamos sobre el estado de tu instalación y las mejores opciones antes de encarar una reforma o un recambio. Presupuesto y recomendaciones sin compromiso.',
    items: ['Diagnóstico de instalación', 'Opciones de reforma', 'Presupuesto detallado', 'Recomendaciones de uso'],
  },
];
---

<Base
  titulo="Servicios"
  descripcion="Servicios de Aluaro: mantenimiento preventivo y asesoramiento hidráulico y sanitario para edificios, comercios y hogares en Uruguay."
>
  <!-- Encabezado de página con imagen de fondo -->
  <section class="cabecera-pagina">
    <div class="cabecera-pagina__fondo" aria-hidden="true"></div>
    <div class="contenedor cabecera-pagina__contenido">
      <p class="cabecera-pagina__kicker">Servicios</p>
      <h1>Todo lo que hacemos con el agua de tu instalación</h1>
      <p class="cabecera-pagina__bajada">
        Desde el mantenimiento continuo de un edificio hasta el asesoramiento
        para una reforma. Estos son los servicios que ofrecemos.
      </p>
    </div>
  </section>

  <!-- Listado de servicios -->
  <section class="seccion">
    <div class="contenedor">
      <div class="lista-servicios">
        {
          servicios.map((s) => (
            <article class="servicio-det">
              <div class="servicio-det__cabecera">
                <h2>{s.titulo}</h2>
              </div>
              <p class="servicio-det__desc">{s.desc}</p>
              <ul class="servicio-det__items">
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bloque: nuestros trabajos (galería) -->
  <section class="seccion seccion--claro">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <h2>Nuestros trabajos</h2>
        <p class="intro">
          Bombas de presión, sistemas de recirculación y salas de máquinas.
          Conocemos los equipos que mantienen el agua funcionando en un edificio
          y sabemos cómo cuidarlos.
        </p>
      </div>
      <div class="galeria">
        <figure class="galeria__item">
          <img src="/imagenes/trabajo-1.jpg" alt="Bombas presurizadoras verticales instaladas en una sala de máquinas" loading="lazy" width="1000" height="1250" />
        </figure>
        <figure class="galeria__item">
          <img src="/imagenes/trabajo-2.jpg" alt="Sistema de dos bombas presurizadoras con cañería nueva" loading="lazy" width="1000" height="1250" />
        </figure>
        <figure class="galeria__item">
          <img src="/imagenes/trabajo-3.jpg" alt="Bomba presurizadora con manómetro y llaves de corte" loading="lazy" width="1000" height="1250" />
        </figure>
      </div>
    </div>
  </section>

  <LlamadaAccion
    titulo="¿No ves lo que necesitás?"
    texto="Escribinos y te decimos si podemos ayudarte. La mayoría de los problemas hidráulicos entran dentro de lo que hacemos."
  />
</Base>

<style>
  /* Cabecera con imagen de fondo */
  .cabecera-pagina {
    position: relative;
    color: var(--blanco);
    padding: 5rem 0 4rem;
    overflow: hidden;
    isolation: isolate;
  }
  .cabecera-pagina__fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: url('/imagenes/sala-maquinas.jpg');
    background-size: cover;
    background-position: center;
  }
  .cabecera-pagina::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(150deg, rgba(10,37,64,0.92) 0%, rgba(18,85,126,0.82) 100%);
  }
  .cabecera-pagina__kicker {
    color: var(--agua);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }
  .cabecera-pagina h1 { color: var(--blanco); max-width: 20ch; }
  .cabecera-pagina__bajada {
    color: #dcecf5;
    font-size: 1.1rem;
    max-width: 56ch;
    margin-top: 1rem;
  }

  .lista-servicios {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }
  .servicio-det {
    border: 1px solid var(--linea);
    border-left: 4px solid var(--agua);
    border-radius: var(--radio);
    padding: 1.75rem;
    background: var(--blanco);
  }
  .servicio-det h2 {
    font-size: 1.35rem;
    color: var(--azul);
    margin-bottom: 0.75rem;
  }
  .servicio-det__desc {
    color: var(--gris);
    font-size: 0.98rem;
  }
  .servicio-det__items {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem 1rem;
  }
  .servicio-det__items li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.92rem;
    color: var(--texto);
  }
  .servicio-det__items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--agua);
  }

  /* Galería de trabajos */
  .galeria {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .galeria__item {
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(10, 37, 64, 0.15);
    aspect-ratio: 4 / 5;
  }
  .galeria__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .galeria__item:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 820px) {
    .lista-servicios { grid-template-columns: 1fr; }
    .galeria { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 500px) {
    .galeria { grid-template-columns: 1fr; max-width: 340px; margin: 0 auto; }
  }
  @media (max-width: 460px) {
    .servicio-det__items { grid-template-columns: 1fr; }
  }
</style>