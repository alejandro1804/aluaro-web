---
import Base from '../layouts/Base.astro';
import LlamadaAccion from '../components/LlamadaAccion.astro';

const servicios = [
  {
    titulo: 'Destapaciones',
    desc: 'Desobstruimos cañerías, desagües, piletas, inodoros y bajadas de edificios con equipo especializado. Resolvemos obstrucciones simples y también las que requieren máquina destapadora.',
    items: ['Cañerías y desagües', 'Bajadas de edificios', 'Piletas y rejillas', 'Cámaras de inspección'],
  },
  {
    titulo: 'Reparación de pérdidas y filtraciones',
    desc: 'Detectamos el origen de la pérdida y reparamos la instalación afectada, minimizando roturas innecesarias. Trabajamos sobre cañerías de agua fría, caliente y desagües.',
    items: ['Detección de filtraciones', 'Reparación de cañerías', 'Pérdidas en griferías', 'Humedades por instalación'],
  },
  {
    titulo: 'Instalaciones sanitarias',
    desc: 'Ejecutamos y renovamos instalaciones sanitarias completas o parciales. Desde el recambio de una grifería hasta la reforma integral de un baño o cocina.',
    items: ['Cañerías nuevas', 'Griferías y sanitarios', 'Reformas de baños', 'Instalación en cocinas'],
  },
  {
    titulo: 'Mantenimiento preventivo',
    desc: 'Planes periódicos pensados para edificios, comercios y empresas. Revisamos el estado de la instalación y anticipamos problemas antes de que se conviertan en urgencias.',
    items: ['Revisiones programadas', 'Informe de estado', 'Limpieza de columnas', 'Coordinación con administración'],
  },
  {
    titulo: 'Urgencias',
    desc: 'Atendemos situaciones que no pueden esperar: pérdidas activas, desbordes y obstrucciones que afectan el uso diario. Coordinamos la visita a la brevedad posible.',
    items: ['Pérdidas activas', 'Desbordes', 'Obstrucciones críticas', 'Cortes de agua por rotura'],
  },
  {
    titulo: 'Asesoramiento',
    desc: 'Te orientamos sobre el estado de tu instalación y las mejores opciones antes de encarar una reforma o un recambio. Presupuesto y recomendaciones sin compromiso.',
    items: ['Diagnóstico de instalación', 'Opciones de reforma', 'Presupuesto detallado', 'Recomendaciones de uso'],
  },
];
---

<Base
  titulo="Servicios"
  descripcion="Servicios de Aluaro: destapaciones, reparación de pérdidas, instalaciones sanitarias, mantenimiento preventivo, urgencias y asesoramiento en Uruguay."
>
  <!-- Encabezado de página -->
  <section class="cabecera-pagina">
    <div class="contenedor">
      <p class="cabecera-pagina__kicker">Servicios</p>
      <h1>Todo lo que hacemos con el agua de tu instalación</h1>
      <p class="cabecera-pagina__bajada">
        Desde una destapación puntual hasta el mantenimiento continuo de un
        edificio. Estos son los servicios que ofrecemos.
      </p>
    </div>
  </section>

  <!-- Listado de servicios -->
  <section class="seccion">
    <div class="contenedor">
      <div class="lista-servicios">
        {
          servicios.map((s) => (
            <article class="servicio-det">
              <div class="servicio-det__cabecera">
                <h2>{s.titulo}</h2>
              </div>
              <p class="servicio-det__desc">{s.desc}</p>
              <ul class="servicio-det__items">
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <LlamadaAccion
    titulo="¿No ves lo que necesitás?"
    texto="Escribinos y te decimos si podemos ayudarte. La mayoría de los problemas hidráulicos entran dentro de lo que hacemos."
  />
</Base>

<style>
  .cabecera-pagina {
    background: linear-gradient(155deg, var(--tinta) 0%, var(--azul) 100%);
    color: var(--blanco);
    padding: 3.5rem 0 3rem;
  }
  .cabecera-pagina__kicker {
    color: var(--agua);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }
  .cabecera-pagina h1 { color: var(--blanco); max-width: 20ch; }
  .cabecera-pagina__bajada {
    color: #cfe0ec;
    font-size: 1.1rem;
    max-width: 56ch;
    margin-top: 1rem;
  }

  .lista-servicios {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }
  .servicio-det {
    border: 1px solid var(--linea);
    border-left: 4px solid var(--agua);
    border-radius: var(--radio);
    padding: 1.75rem;
    background: var(--blanco);
  }
  .servicio-det h2 {
    font-size: 1.35rem;
    color: var(--azul);
    margin-bottom: 0.75rem;
  }
  .servicio-det__desc {
    color: var(--gris);
    font-size: 0.98rem;
  }
  .servicio-det__items {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem 1rem;
  }
  .servicio-det__items li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.92rem;
    color: var(--texto);
  }
  .servicio-det__items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--agua);
  }

  @media (max-width: 820px) {
    .lista-servicios { grid-template-columns: 1fr; }
  }
  @media (max-width: 460px) {
    .servicio-det__items { grid-template-columns: 1fr; }
  }
</style>
